{
  "components": {
    "schemas": {
      "AppointmentBody": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "format": "date-time",
            "type": "string"
          },
          "bookingId": {
            "type": "string"
          },
          "cup": {
            "$ref": "#/components/schemas/PrescriptionCUPBody"
          },
          "fse": {
            "$ref": "#/components/schemas/PrescriptionFSEBody"
          },
          "id": {
            "type": "string"
          },
          "nre": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "unit": {
            "$ref": "#/components/schemas/UnitBody"
          }
        },
        "required": ["id", "nre", "status", "unit"],
        "type": "object"
      },
      "AppointmentsBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["https://example.com/schemas/AppointmentsBody.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "appointments": {
            "items": {
              "$ref": "#/components/schemas/AppointmentBody"
            },
            "type": ["array", "null"]
          },
          "failed": {
            "items": {
              "$ref": "#/components/schemas/FailedBody"
            },
            "type": ["array", "null"]
          },
          "unbooked": {
            "items": {
              "type": "string"
            },
            "type": ["array", "null"]
          }
        },
        "required": ["appointments", "failed", "unbooked"],
        "type": "object"
      },
      "CalendarEventBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["https://example.com/schemas/CalendarEventBody.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "created": {
            "type": "boolean"
          },
          "htmlLink": {
            "type": "string"
          }
        },
        "required": ["htmlLink", "created"],
        "type": "object"
      },
      "CalendarEventRequest": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": [
              "https://example.com/schemas/CalendarEventRequest.json"
            ],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "appointmentId": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "attachPromemoria": {
            "default": true,
            "type": "boolean"
          },
          "bookingId": {
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9]+$",
            "type": "string"
          },
          "details": {
            "maxLength": 1000,
            "type": "string"
          },
          "durationMinutes": {
            "default": 60,
            "format": "int64",
            "maximum": 480,
            "minimum": 5,
            "type": "integer"
          },
          "location": {
            "maxLength": 300,
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["appointmentId", "title", "start"],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["https://example.com/schemas/ErrorModel.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": ["Property foo is required but is missing."],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": ["array", "null"]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": ["https://example.com/error-log/abc123"],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [400],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": ["Bad Request"],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": ["https://example.com/errors/example"],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "FailedBody": {
        "additionalProperties": false,
        "properties": {
          "nre": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": ["nre", "reason"],
        "type": "object"
      },
      "GoogleConnectBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["https://example.com/schemas/GoogleConnectBody.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "authUrl": {
            "type": "string"
          }
        },
        "required": ["authUrl"],
        "type": "object"
      },
      "GoogleStatusBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["https://example.com/schemas/GoogleStatusBody.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "configured": {
            "type": "boolean"
          },
          "connected": {
            "type": "boolean"
          }
        },
        "required": ["configured", "connected"],
        "type": "object"
      },
      "LoginBody": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "phase": {
            "enum": ["idle", "waiting", "failed"],
            "type": "string"
          }
        },
        "required": ["phase"],
        "type": "object"
      },
      "PortalBody": {
        "additionalProperties": false,
        "properties": {
          "accessExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "login": {
            "$ref": "#/components/schemas/LoginBody"
          },
          "portal": {
            "enum": ["cup", "fse"],
            "type": "string"
          },
          "refreshExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "state": {
            "enum": ["logged_out", "active", "expired"],
            "type": "string"
          }
        },
        "required": ["portal", "state", "login"],
        "type": "object"
      },
      "PrescriptionCUPBody": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": ["array", "null"]
          },
          "kind": {
            "type": "string"
          },
          "nre": {
            "type": "string"
          },
          "prescribedOn": {
            "format": "date-time",
            "type": "string"
          },
          "status": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": ["nre", "kind", "status", "items"],
        "type": "object"
      },
      "PrescriptionFSEBody": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "documentRef": {
            "type": "string"
          },
          "expiresOn": {
            "format": "date-time",
            "type": "string"
          },
          "expiryEstimated": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "nre": {
            "type": "string"
          },
          "status": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "nre",
          "description",
          "kind",
          "status",
          "documentRef"
        ],
        "type": "object"
      },
      "PrescriptionsBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["https://example.com/schemas/PrescriptionsBody.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "prescriptions": {
            "items": {
              "$ref": "#/components/schemas/RowBody"
            },
            "type": ["array", "null"]
          }
        },
        "required": ["prescriptions"],
        "type": "object"
      },
      "RowBody": {
        "additionalProperties": false,
        "properties": {
          "cup": {
            "$ref": "#/components/schemas/PrescriptionCUPBody"
          },
          "fse": {
            "$ref": "#/components/schemas/PrescriptionFSEBody"
          },
          "nre": {
            "type": "string"
          }
        },
        "required": ["nre"],
        "type": "object"
      },
      "SessionBody": {
        "additionalProperties": false,
        "properties": {
          "$schema": {
            "description": "A URL to the JSON Schema for this object.",
            "examples": ["https://example.com/schemas/SessionBody.json"],
            "format": "uri",
            "readOnly": true,
            "type": "string"
          },
          "gestioneReady": {
            "type": "boolean"
          },
          "portals": {
            "items": {
              "$ref": "#/components/schemas/PortalBody"
            },
            "type": ["array", "null"]
          }
        },
        "required": ["portals", "gestioneReady"],
        "type": "object"
      },
      "UnitBody": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "province": {
            "type": "string"
          }
        },
        "required": ["name", "description", "address", "city", "province"],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "fuck-toscana-salute",
